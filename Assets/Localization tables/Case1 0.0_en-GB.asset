  m_TableData:
  - m_Id: 14899748003840
    m_Localized: "I'm\_Leon Friedrich, 34 years old, working in a LED factory.\_I've\_been
      a citizen of the Munster closed city since the beginning of the thing."
    m_Metadata:
      m_Items: []
  - m_Id: 14899748003841
    m_Localized: "Life sucked all the way since then, at least now it\_can't\_get
      worse.\_It's\_a strange feeling looking at all the people who still have close
      ones\_you know.\_Just waiting for the looming tragedy.\_"
    m_Metadata:
      m_Items: []
  - m_Id: 14899748003842
    m_Localized: "We all got used to it.\_\_"
    m_Metadata:
      m_Items: []
