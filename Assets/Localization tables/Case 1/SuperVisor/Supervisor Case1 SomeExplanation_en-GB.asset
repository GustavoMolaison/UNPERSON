  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Supervisor Case1 SomeExplanation_en-GB
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en-GB
  m_SharedData: {fileID: 11400000, guid: c9b06d29efd07c9469bcacd8f107775c, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5988409344
    m_Localized: For your knowing i see you through that litte sweet camera.
    m_Metadata:
      m_Items: []
  - m_Id: 235358117888
    m_Localized: So dont pick in your noses or burp cause you are on the job. Very
      serious job!
    m_Metadata:
      m_Items: []
  - m_Id: 237304274944
    m_Localized: Negative behaviour will give you negative points in my personal
      ranking.
    m_Metadata:
      m_Items: []
  - m_Id: 238977802240
    m_Localized: "We are the goverment for damn sake. We must represesnt some level
      of \r\nprofessionalism."
    m_Metadata:
      m_Items: []
  - m_Id: 1137376747520
    m_Localized: All of you will solve your first case today. I hope you are excited!
    m_Metadata:
      m_Items: []
  - m_Id: 1296152125440
    m_Localized: 'One newbie at a time i  will help you so dont worry. Only this
      once. '
    m_Metadata:
      m_Items: []
  - m_Id: 1507255640064
    m_Localized: But remember im jugemental man. So try to not irrate me with your
      stupidy if you may.
    m_Metadata:
      m_Items: []
  - m_Id: 1760914563072
    m_Localized: If you succed in irrating me. Well you propably will lose job. And
      then god knows where central comitty will put you.
    m_Metadata:
      m_Items: []
  - m_Id: 1919350202368
    m_Localized: 'Okay you the one looking like lost child. I dont like face what
      you think better than this? '
    m_Metadata:
      m_Items: []
  - m_Id: 2174959476736
    m_Localized: 'Nobody cares, focus up! '
    m_Metadata:
      m_Items: []
  - m_Id: 331115352023040
    m_Localized: I picked a case for you already. Should be an easy case! First of
      many!
    m_Metadata:
      m_Items: []
  - m_Id: 332684487286784
    m_Localized: You see that computer? From what i know about you. You are familiar
      with them.
    m_Metadata:
      m_Items: []
  - m_Id: 333058568871936
    m_Localized: 'Waste of working motherboards if you ask me. But they did give
      you those. So use them gently. '
    m_Metadata:
      m_Items: []
  - m_Id: 333479307894784
    m_Localized: 'Go into suspect section pick the sad man in glasses. And click
      "Interrogate". Basic computer usage.  '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
